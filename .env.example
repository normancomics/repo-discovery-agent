# GitHub token (public_repo read access is enough). Required to avoid rate limits.
GITHUB_TOKEN=
# GitHub user whose repos are excluded from results (self-exclude)
GITHUB_OWNER=normancomics
# Where the markdown report is written
REPORT_PATH=reports/discovery-report.md
# Minimum score (0-100) for a match to be included
MIN_SCORE=40
# Max matches per category in the report
TOP_N=12
# Max results fetched per search query
PER_QUERY=15

# x402 HTTP service (src/server)
PORT=4021
PUBLIC_URL=              # optional; Render sets RENDER_EXTERNAL_URL automatically
PAY_TO=0x3d95D4A6DbaE0Cd0643a82b13A13b08921D6ADf7
FACILITATOR_URL=https://facilitator.payai.network
RATE_LIMIT_PER_MIN=60
