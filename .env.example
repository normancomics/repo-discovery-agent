# Required: GitHub token (read-only public access is enough; no scopes needed)
GITHUB_TOKEN=

# Optional: LLM for profile summaries and outreach drafts (falls back to templates if unset)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai | anthropic (auto-detected from the keys above if omitted)
# LLM_MODEL=gpt-4o-mini

# Optional: use OpenAI embeddings for semantic similarity (lexical only if unset)
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: override output location (default: ./output)
# OUTPUT_DIR=output
